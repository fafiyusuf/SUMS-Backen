# Server
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sums_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=24h

# Telebirr API
TELEBIRR_API_URL=https://api.telebirr.et
TELEBIRR_APP_ID=your_app_id
TELEBIRR_APP_KEY=your_app_key
TELEBIRR_TOKEN_URL=https://api.telebirr.et/oauth/token
TELEBIRR_CREATE_ORDER_URL=https://api.telebirr.et/payment/create
TELEBIRR_CHECKOUT_BASE_URL=https://checkout.telebirr.et/checkout
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...your base64 key...\n-----END PRIVATE KEY-----"
APP_SECRET=your_app_secret
MERCHANT_CODE=your_merchant_shortcode
MERCHANT_APP_ID=your_merchant_appid

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:19006

# Redis (optional for session/cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
