# Server
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sums_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=24h

# Telebirr API
TELEBIRR_API_URL=https://api.telebirr.et
TELEBIRR_APP_ID=your_app_id
TELEBIRR_APP_KEY=your_app_key

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:19006

# Redis (optional for session/cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
